{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "replicas": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "pytorchInitContainer": {
      "type": "object",
      "required": ["customTemplate", "image", "maxTries", "imagePullPolicy", "sleepSeconds", "resources"],
      "properties": {
        "customTemplate": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" }
          }
        },
        "maxTries": { "type": "integer", "minimum": 1 },
        "imagePullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "sleepSeconds": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "mpiKubectlDeliveryImage": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" }
      }
    },
    "mpi": {
      "type": "object",
      "properties": {
        "disableRBACManagement": { "type": "boolean" }
      }
    },
    "testImage": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "webhookPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "webhook": {
      "type": "object",
      "properties": {
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "podAnnotations": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enable": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "null"], "minimum": 0 },
        "maxUnavailable": { "type": ["integer", "null"], "minimum": 0 }
      },
      "if": {
        "properties": { "maxUnavailable": { "type": "integer" } },
        "required": ["maxUnavailable"]
      },
      "then": {
        "not": {
          "properties": { "minAvailable": { "type": "integer" } },
          "required": ["minAvailable"]
        }
      }
    },
    "leaderElection": {
      "type": "object",
      "properties": {
        "enable": { "type": "boolean" }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 }
  }
}
